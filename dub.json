{
  "name": "retrograde",
  "description": "The Retrograde Game Engine",
  "authors": ["Mike Bierlee", "Lostmoment"],
  "license": "MIT",
  "copyright": "Copyright Mike Bierlee 2014-2026",
  "dflags": ["-betterC"],
  "targetPath": "bin",
  "configurations": [
    {
      "name": "library",
      "targetType": "library"
    },
    {
      "name": "unittest-native",
      "targetType": "library",
      "sourcePaths": ["source"],
      "importPaths": ["source"],
      "versions": ["Native", "UnitTesting", "NoGraphicsApi"]
    }
  ],
  "buildTypes": {
    "debug": {
      "buildOptions": ["debugMode", "debugInfo"],
      "buildOptions-windows": ["debugInfoC"]
    },
    "release-O3": {
      "buildOptions": ["releaseMode"],
      "dflags-ldc2": ["-O3"]
    }
  },
  "stringImportPaths": ["source/retrograde/shaders"]
}
